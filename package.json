{
  "name": "trawl",
  "version": "0.1.0",
  "description": "Search every conversation you've had with your coding agents (Claude Code, Codex, opencode). Fully local.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "search",
    "cli",
    "transcripts",
    "agents"
  ],
  "license": "MIT",
  "author": "KorigamiK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KorigamiK/trawl.git"
  },
  "type": "module",
  "bin": {
    "trawl": "./src/cli.ts"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --minify --outfile dist/trawl"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
